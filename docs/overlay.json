{
  "_readme": [
    "Editorial decisions applied on top of docs/syllabus.json by scripts/build_syllabus.py.",
    "The source list (jlptgrammarlist.neocities.org) has no entry for を, the direct",
    "object particle, at any level, and is missing こそあど, question words, adjective",
    "conjugation, ましょう/ませんか and んです from N5. Its own changelog shows it was",
    "assembled over 28 days in 2020 and sorted 'alphanumerically'. It is therefore used",
    "as a starting skeleton and a source of sense-disambiguation glosses, not as a",
    "syllabus authority. Scope decisions cross-checked against Bunpro, JLPT Sensei and",
    "Shin Kanzen Master. Every deviation from the source is recorded here."
  ],
  "drop": [
    "Verb Conjugation"
  ],
  "move": {
    "ほしい": "n5",
    "すぎる": "n5",
    "なくてはいけない / なくてはならない": "n5",
    "てからでないと": "n3",
    "だけでなく": "n3",
    "ことから": "n3",
    "に従って": "n3",
    "ようがない / ようもない": "n3",
    "上で": "n3",
    "際に": "n3",
    "ばかりに": "n3",
    "ばかりだ": "n3",
    "ぶりに": "n3",
    "ごとに": "n3",
    "か何か": "n3",
    "を通じて / を通して": "n3",
    "をこめて": "n3",
    "ことになっている": "n3"
  },
  "relabel": {
    "ことに": {
      "gloss": "to my surprise / delight (speaker's reaction to what follows)",
      "why": "Source glossed this '-ly', which describes the unrelated adverbial 〜ことに. The pattern is 〜ことに(は) and mainstream references place it at N2, but it is kept at N3 here since the surrounding cluster is taught at N3."
    },
    "ということ": {
      "term": "ということだ / とのことだ",
      "gloss": "I hear that; word is that (reported information)",
      "why": "The N3 entry duplicated the N4 nominaliser ということ. The genuine N3 point is the hearsay form, which is what the source's own gloss describes."
    },
    "が#1": {
      "gloss": "marks the subject; singles out which one",
      "why": "Source gloss was 'as for (identifies something)', which is a gloss of は. Left uncorrected this produces a が page that contradicts the は page on the single most important contrast in beginner Japanese."
    },
    "しか○○ない": {
      "gloss": "only; nothing but (with material between しか and ない)",
      "why": "Disambiguated from N3 しかない 'have no choice but', which is a different pattern."
    }
  },
  "merge": [
    {
      "from": [
        "だろう#1",
        "だろう#2",
        "でしょう#1",
        "でしょう#2"
      ],
      "term": "だろう・でしょう",
      "gloss": "probably; ... right? (conjecture, and seeking agreement)",
      "level": "n5",
      "why": "Four source pages for one form. だろう/でしょう is a plain/polite alternation, and sense 1 vs 2 is falling vs rising intonation. Splitting them hides both relationships."
    },
    {
      "from": [
        "ほうがいい#1",
        "ほうがいい#2"
      ],
      "term": "ほうがいい",
      "gloss": "it'd be better to (and, negated, better not to)",
      "level": "n5",
      "why": "Sense 2 is sense 1 negated. That is conjugation, not a second grammar point."
    }
  ],
  "split": [
    {
      "from": "に / へ",
      "why": "Two different particles sharing one gloss ('to'). They overlap for destination and diverge everywhere else; a single page cannot teach the difference it exists to teach.",
      "into": [
        {
          "term": "に",
          "gloss": "destination, time, recipient, and location of existence"
        },
        {
          "term": "へ",
          "gloss": "direction - toward (and its use in set phrases)"
        }
      ]
    }
  ],
